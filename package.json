{
  "name": "thai-stock-investment-web",
  "version": "0.1.0",
  "description": "Node.js web app migration for the Thai stock investment analysis system.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js",
    "compare:python": "node scripts/comparePythonOutputs.js",
    "test:tenant-access": "node scripts/tenantAccessRegression.js",
    "test:subscription-lifecycle": "node scripts/subscriptionLifecycleRegression.js",
    "test:storage-readiness": "node scripts/storageReadinessRegression.js",
    "test:state-repository": "node scripts/stateRepositoryRegression.js",
    "test:postgres-repository": "node scripts/postgresStateRepositoryRegression.js",
    "test:postgres-importer": "node scripts/postgresStateImporterRegression.js",
    "test:audit-trail": "node scripts/auditTrailRepositoryRegression.js",
    "test:approval-workflow": "node scripts/approvalWorkflowRegression.js",
    "test:entitlements": "node scripts/entitlementPolicyRegression.js",
    "test:payment-provider": "node scripts/paymentProviderRegression.js",
    "test:audit-external": "node scripts/auditTrailExternalProviderRegression.js",
    "test:dependency-risk": "node scripts/dependencyRiskRegression.js",
    "test:backup-restore": "node scripts/backupRestoreRegression.js",
    "test:observability": "node scripts/observabilityRegression.js",
    "test:ops-alerts": "node scripts/operationalAlertDeliveryRegression.js",
    "test:postgres-backup-runbook": "node scripts/postgresBackupRunbookRegression.js",
    "test:deployment-checklist": "node scripts/deploymentChecklistRegression.js",
    "test:frontend-viewport": "node scripts/frontendViewportRegression.js",
    "test:frontend-auth": "node scripts/frontendAuthenticatedSmokeRegression.js",
    "test:web-smoke": "node scripts/webAppSmokeRegression.js",
    "import:postgres": "node scripts/importAppStateToPostgres.js",
    "postgres:backup-runbook": "node scripts/postgresBackupRunbook.js",
    "deployment:check": "node scripts/deploymentChecklist.js",
    "ops:alerts": "node scripts/operationalAlertDelivery.js",
    "backup:state": "node scripts/backupAppState.js",
    "restore:state": "node scripts/restoreAppStateBackup.js",
    "test-regression": "npm run check && npm run test:tenant-access && npm run test:subscription-lifecycle && npm run test:storage-readiness && npm run test:state-repository && npm run test:postgres-repository && npm run test:postgres-importer && npm run test:audit-trail && npm run test:approval-workflow && npm run test:entitlements && npm run test:payment-provider && npm run test:audit-external && npm run test:backup-restore && npm run test:observability && npm run test:ops-alerts && npm run test:postgres-backup-runbook && npm run test:deployment-checklist && npm run test:frontend-viewport && npm run test:frontend-auth && npm run test:web-smoke && npm run compare:python",
    "ci:quality": "npm run test-regression && npm run test:dependency-risk"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^2.1.1"
  }
}
